NODE_ENV=development
LOG_LEVEL=info
HOST=localhost
PORT=3000

# Application runtime role: non-superuser, subject to FORCE ROW LEVEL SECURITY.
# Used by `api`, `worker`, and the integration/E2E suites.
DATABASE_URL=postgres://watchdog_app:watchdog_app_dev_password@127.0.0.1:5432/watchdog?sslmode=disable

# Owner role: schema owner, runs DBMate migrations. Never used for app traffic.
DBMATE_DATABASE_URL=postgres://watchdog_owner:watchdog_owner_dev_password@127.0.0.1:5432/watchdog?sslmode=disable

# Consumed by the Compose postgres service and its init script only;
# the application config loader does not read these.
POSTGRES_DB=watchdog
POSTGRES_USER=watchdog_owner
POSTGRES_PASSWORD=watchdog_owner_dev_password
WATCHDOG_APP_PASSWORD=watchdog_app_dev_password

# Better Auth. Generate a real secret per environment:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=dev_only_change_me
BETTER_AUTH_URL=http://localhost:3000
