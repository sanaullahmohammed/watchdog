NODE_ENV=development
LOG_LEVEL=info
HOST=localhost
PORT=3000

# Application runtime role: non-superuser, subject to FORCE ROW LEVEL SECURITY.
# Used by `api`, `worker`, and the integration/E2E suites.
DATABASE_URL=postgres://watchdog_app:watchdog_app_dev_password@127.0.0.1:5432/watchdog?sslmode=disable

# Owner role: schema owner, runs DBMate migrations. Never used for app traffic.
DBMATE_DATABASE_URL=postgres://watchdog_owner:watchdog_owner_dev_password@127.0.0.1:5432/watchdog?sslmode=disable

# Consumed by the Compose postgres service and its init script only;
# the application config loader does not read these.
POSTGRES_DB=watchdog
POSTGRES_USER=watchdog_owner
POSTGRES_PASSWORD=watchdog_owner_dev_password
WATCHDOG_APP_PASSWORD=watchdog_app_dev_password

# Better Auth. Generate a real secret per environment:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=dev_only_change_me_dev_only_change_me
BETTER_AUTH_URL=http://localhost:3000

# Monitor targets that resolve into loopback, private, link-local or other
# blocked ranges are refused (ARCHITECTURE.md 6.5). To monitor internal
# services, list the ranges to allow, comma-separated. Empty by default; an
# invalid entry fails boot. Example: 10.20.0.0/16,fd00:1234::/32
MONITOR_ALLOWED_CIDRS=

# Raw check results are kept this many days. The worker drops monthly
# partitions wholly older than this. Whole number, at least 1.
CHECK_RESULTS_RETENTION_DAYS=30

# Daily uptime rollups older than this many days are pruned by the worker.
# Whole number, 1 to 36500. Default 400.
ROLLUP_RETENTION_DAYS=400

# How many monitor checks one worker process runs at once. Each running check
# holds a slot until its result is recorded, so this also bounds the database
# connections recording uses. Whole number, 1 to 1000. Default 10.
MONITOR_CHECK_CONCURRENCY=10

# How often the worker looks for monitors whose check is due, in milliseconds.
# At least 1000, at most 2147483647, and below WORKER_PASS_OVERDUE_MS.
# Default 10000.
# WORKER_MONITOR_INTERVAL_MS=10000

# How long a worker loop may go without completing a pass before the
# healthcheck fails, in milliseconds. For the monitor loop it is also the stall
# window: a tick fails when checks are queued or running and none has settled
# for this long, so health turns red within about twice this. A backlog alone is
# not a stall. It must exceed the longest check timeout (60 s) plus recording.
# Default 120000.
# WORKER_PASS_OVERDUE_MS=120000

# The public status stream, GET /status/:orgSlug/events (ARCHITECTURE.md
# 5.4.1). Open streams are capped per client IP and per api process; an
# opening beyond either cap answers 429. Each stream is closed after its
# lifetime, and the client reconnects. A heartbeat comment is written after
# this many seconds without a write; it is not one of 5.4.1's bounds, it keeps
# intermediaries from cutting an idle stream. The two times are seconds, 1 to
# 2147483. Defaults below.
# PUBLIC_STREAM_MAX_PER_IP=10
# PUBLIC_STREAM_MAX_TOTAL=1000
# PUBLIC_STREAM_MAX_LIFETIME_SECONDS=3600
# PUBLIC_STREAM_HEARTBEAT_SECONDS=30

# How often an admin subscription re-checks its access, in seconds, 1 to 2147483.
# ADMIN_SUBSCRIPTION_RECHECK_SECONDS=60

# Outgoing email (FR19, ARCHITECTURE.md 5.6). The defaults reach Mailpit, which
# `docker compose up -d` publishes on localhost:1025 (its inbox is at
# http://localhost:8025). SMTP_PORT is 1 to 65535. SMTP_SECURE=true uses TLS
# from the first byte, usually on port 465; false upgrades through STARTTLS when
# the server offers it. SMTP_USER and SMTP_PASSWORD are set together or not at
# all; an empty value counts as unset.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_FROM=WatchDog <watchdog@localhost>
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# The origin emailed links are built on: a bare http(s) origin, with no path.
# Unset or empty, it is BETTER_AUTH_URL's origin.
# PUBLIC_BASE_URL=http://localhost:3000
