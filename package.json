{
  "name": "watchdog",
  "version": "0.1.0",
  "description": "Self-hosted, multi-tenant status page platform with human-in-the-loop AI assistance.",
  "author": "Sanaullah Mohammad",
  "license": "MIT",
  "scripts": {
    "create:env": "node -r fs -e \"fs.copyFileSync('.env.example', '.env', fs.constants.COPYFILE_EXCL)\"",
    "dev": "tsx watch src --env-file=.env | pino-pretty",
    "build": "rm -rf ./dist && tsc --project tsconfig.build.json && resolve-tspaths -p tsconfig.build.json -s ./src -o ./dist",
    "start:prod": "node ./dist/index.js --env-file=.env",
    "check": "pnpm run format:ci && pnpm run lint:ci && pnpm run type:check && pnpm run deps:validate",
    "format": "biome format --write .",
    "format:ci": "biome format .",
    "lint": "biome lint --write .",
    "lint:ci": "biome lint .",
    "type:check": "tsc --noEmit",
    "test": "pnpm run test:unit",
    "test:unit": "node --import tsx --test src/**/*.spec.ts",
    "test:coverage": "c8 node --import tsx --test src/**/*.spec.ts",
    "test:e2e": "npx cucumber-js --exit",
    "test:k6:smoke": "k6 run tests/load/smoke.js",
    "test:k6:load": "k6 run tests/load/load.js",
    "db": "dbmate h",
    "db:create-migration": "dbmate new",
    "db:migrate": "dbmate -e DBMATE_DATABASE_URL up",
    "db:create-seed": "dbmate -e DBMATE_DATABASE_URL -d ./db/seeds/ new",
    "db:seed": "dbmate -e DBMATE_DATABASE_URL -d ./db/seeds/ up",
    "depcruise": "depcruise",
    "deps:validate": "depcruise src --config .dependency-cruiser.js --output-type err-long",
    "deps:graph": "depcruise src --include-only \"^src\" --config --output-type dot | dot -T svg > docs/dependency-graph.svg",
    "generate:client-types": "npx openapi-typescript http://127.0.0.1:3000/api-docs/json -o ./client.schema.d.ts",
    "prepare": "husky",
    "outdated": "pnpm update --interactive --latest",
    "auth:schema:generate": "auth generate --config src/server/plugins/auth/auth.ts --output db/better-auth-schema.sql --yes",
    "auth:schema:check": "node scripts/check-auth-schema.mjs"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@fastify/autoload": "6.3.1",
    "@fastify/awilix": "8.2.0",
    "@fastify/cors": "11.2.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/request-context": "6.2.1",
    "@fastify/swagger": "9.6.1",
    "@fastify/swagger-ui": "5.2.5",
    "@fastify/type-provider-json-schema-to-ts": "5.0.0",
    "@fastify/type-provider-typebox": "6.1.0",
    "@fastify/under-pressure": "9.0.3",
    "@gquittet/graceful-server": "6.0.3",
    "@graphql-tools/load-files": "7.0.1",
    "@graphql-tools/merge": "9.1.7",
    "ajv": "^8.20.0",
    "ajv-formats": "3.0.1",
    "awilix": "12.0.5",
    "better-auth": "^1.7.3",
    "env-schema": "7.0.0",
    "fastify": "5.7.2",
    "fastify-plugin": "5.1.0",
    "graphql": "16.12.0",
    "helmet": "8.1.0",
    "mercurius": "16.7.0",
    "pg": "^8.23.0",
    "pino": "10.3.0",
    "postgres": "3.4.8",
    "ramda": "0.32.0",
    "typebox": "1.0.80"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@commitlint/cli": "20.3.1",
    "@commitlint/config-conventional": "20.3.1",
    "@cucumber/cucumber": "12.6.0",
    "@cucumber/html-formatter": "22.3.0",
    "@cucumber/messages": "30.1.0",
    "@cucumber/pretty-formatter": "2.4.1",
    "@tsconfig/node24": "24.0.4",
    "@types/node": "24.10.9",
    "@types/pg": "^8.23.1",
    "@types/ramda": "0.31.1",
    "auth": "^1.7.3",
    "c8": "10.1.3",
    "dbmate": "2.29.3",
    "dependency-cruiser": "17.3.7",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "pino-pretty": "13.1.3",
    "resolve-tspaths": "0.8.23",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "keywords": [
    "status-page",
    "fastify",
    "multi-tenant",
    "postgres",
    "row-level-security",
    "cqrs",
    "domain-driven-design",
    "vertical-slice-architecture",
    "typescript"
  ],
  "private": true,
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
